local joyTouch = nil

joyBase.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        joyTouch = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if joyTouch and input == joyTouch then
        local center = joyBase.AbsolutePosition + joyBase.AbsoluteSize / 2
        local delta = input.Position - center
        local max = joyBase.AbsoluteSize.X / 2
        local mag = math.min(delta.Magnitude, max)
        local dir = delta.Magnitude > 0 and delta.Unit or Vector2.zero
        local pos = dir * mag
        joyKnob.Position = UDim2.fromOffset(joyBase.AbsoluteSize.X / 2 + pos.X, joyBase.AbsoluteSize.Y / 2 + pos.Y)
        joyVector = Vector2.new(pos.X / max, pos.Y / max)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if joyTouch and input == joyTouch then
        joyTouch = nil
        joyVector = Vector2.zero
        joyKnob.Position = UDim2.fromScale(0.5, 0.5)
    end
end)

RunService.RenderStepped:Connect(function()
    joyBase.Visible = C.FreeCam
    joyBase.Position = UDim2.fromOffset(115, Cam.ViewportSize.Y - 125)
end)

