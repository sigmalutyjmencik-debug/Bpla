local function replaceChild(className, name)
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA(className) and c.Name ~= name then
			c:Destroy()
		end
	end

	local e = Lighting:FindFirstChild(name)
	if e and e:IsA(className) then
		return e
	end

	e = Instance.new(className)
	e.Name = name
	e.Parent = Lighting
	return e
end

local skyInitialized = false
local currentSkyPreset = nil

local function destroyAstraVisuals()
	for _, n in ipairs({ "AstraSky", "AstraAtmos", "AstraCC", "AstraBloom", "AstraRays" }) do
		local x = Lighting:FindFirstChild(n)
		if x then
			x:Destroy()
		end
	end
end

local function applySky()
	if not C.SkyOn then
		destroyAstraVisuals()
		skyInitialized = false
		currentSkyPreset = nil
		return
	end

	local p = SkyPresets[C.SkyChoice] or SkyPresets.BlushkaCosmos
	local sky = replaceChild("Sky", "AstraSky")

	if p.ids then
		sky.SkyboxBk = assetId(p.ids.Bk)
		sky.SkyboxDn = assetId(p.ids.Dn)
		sky.SkyboxFt = assetId(p.ids.Ft)
		sky.SkyboxLf = assetId(p.ids.Lf)
		sky.SkyboxRt = assetId(p.ids.Rt)
		sky.SkyboxUp = assetId(p.ids.Up)
	else
		local id = assetId(p.all)
		sky.SkyboxBk = id
		sky.SkyboxDn = id
		sky.SkyboxFt = id
		sky.SkyboxLf = id
		sky.SkyboxRt = id
		sky.SkyboxUp = id
	end

	sky.StarCount = p.stars
	sky.CelestialBodiesShown = p.bodies
	Lighting.ClockTime = p.time
	Lighting.Ambient = p.ambient
	Lighting.OutdoorAmbient = p.ambient

	local at = replaceChild("Atmosphere", "AstraAtmos")
	at.Density = p.atmos.Density
	at.Offset = p.atmos.Offset
	at.Color = p.atmos.Color
	at.Decay = p.atmos.Decay
	at.Glare = p.atmos.Glare
	at.Haze = p.atmos.Haze

	local cc = replaceChild("ColorCorrectionEffect", "AstraCC")
	cc.Brightness = p.cc.Brightness
	cc.Contrast = p.cc.Contrast
	cc.Saturation = p.cc.Saturation
	cc.TintColor = p.cc.Tint

	local bl = replaceChild("BloomEffect", "AstraBloom")
	bl.Intensity = p.bloom.Intensity
	bl.Size = p.bloom.Size
	bl.Threshold = p.bloom.Threshold

	local sr = replaceChild("SunRaysEffect", "AstraRays")
	sr.Intensity = p.rays
	sr.Spread = 0.6
	sr.Enabled = p.rays > 0

	skyInitialized = true
	currentSkyPreset = C.SkyChoice
end

local function resetSkyState()
	skyInitialized = false
	currentSkyPreset = nil
end

local function ensureSky()
	if not C.SkyOn then
		if skyInitialized then
			destroyAstraVisuals()
		end
		skyInitialized = false
		currentSkyPreset = nil
		return
	end

	if not skyInitialized or currentSkyPreset ~= C.SkyChoice or not Lighting:FindFirstChild("AstraSky") then
		applySky()
	end
end

local function isForeignVisual(c)
	if not c or not c.Parent then
		return false
	end

	local okName, n = pcall(function()
		return c.Name
	end)
	if not okName then
		return false
	end

	if n:find("^Astra") then
		return false
	end

	if c:IsA("Sky") and C.SkyOn then
		return true
	end

	if c:IsA("Atmosphere") and (C.NF or C.SkyOn) then
		return true
	end

	if c:IsA("ColorCorrectionEffect") and (C.FB or C.SkyOn) then
		return true
	end

	if c:IsA("BloomEffect") and (C.FB or C.SkyOn) then
		return true
	end

	if c:IsA("SunRaysEffect") and (C.FB or C.SkyOn) then
		return true
	end

	return false
end

local function removeForeignVisuals()
	for _, c in ipairs(Lighting:GetChildren()) do
		if isForeignVisual(c) then
			c:Destroy()
		end
	end
end

local function forceFullbright()
	if not C.FB then
		return
	end

	setIfDiff(Lighting, "Ambient", Color3.fromRGB(180, 180, 180))
	setIfDiff(Lighting, "OutdoorAmbient", Color3.fromRGB(180, 180, 180))
	setIfDiff(Lighting, "Brightness", 1.4)
	setIfDiff(Lighting, "ClockTime", 14)
	setIfDiff(Lighting, "GlobalShadows", false)
	setIfDiff(Lighting, "ExposureCompensation", 0.1)
	setIfDiff(Lighting, "ShadowSoftness", 0)
end

local function forceNoFog()
	if not C.NF then
		return
	end

	setIfDiff(Lighting, "FogEnd", 99999)
	setIfDiff(Lighting, "FogStart", 0)
	setIfDiff(Lighting, "FogColor", Color3.fromRGB(255, 255, 255))

	for _, atm in ipairs(Lighting:GetChildren()) do
		if atm:IsA("Atmosphere") then
			setIfDiff(atm, "Density", 0)
			setIfDiff(atm, "Offset", 0)
			setIfDiff(atm, "Color", Color3.fromRGB(255, 255, 255))
			setIfDiff(atm, "Decay", Color3.fromRGB(0, 0, 0))
			setIfDiff(atm, "Glare", 0)
			setIfDiff(atm, "Haze", 0)
		end
	end
end

local function enforceVisuals()
	ensureSky()
	removeForeignVisuals()
	forceFullbright()
	forceNoFog()
end

