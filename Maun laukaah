local lastAutoFire = 0

RunService.Heartbeat:Connect(function()
    local shouldFire = false
    local fireCD = math.huge

    if C.AutoFire then
        shouldFire = true
        fireCD = C.AutoFireCD
    end

    if C.RapidFire then
        local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        if holding or UserInputService.TouchEnabled then
            shouldFire = true
            fireCD = math.min(fireCD, C.RapidFireCD)
        end
    end

    if not shouldFire then return end
    if tick() - lastAutoFire < fireCD then return end

    local ch = LP.Character
    if not ch then return end
    local tool = ch:FindFirstChildOfClass("Tool")
    if not tool then return end

    local origin = Cam.CFrame.Position
    local part = getTarget(origin, C.SADist)
    if not part then return end

    local S = getSettings(tool)
    local canHit = predictCanHit(origin, part, S)
    if not canHit then return end

    lastAutoFire = tick()

    local muzzle = origin
    if C.MuzzleOffset then
        muzzle = getBestMuzzle(part.Position)
    end
    local dir = solveAim(muzzle, part, S)
    local maxDist = (S and S.MaxDistance) or C.SADist or 600

    registerPendingShot(muzzle, dir, maxDist)

    if GunFire then
        lastShotData.autoCount = lastShotData.autoCount + 1
        local serverTime = Workspace:GetServerTimeNow()
        local seq = (lastShotData.lastSeq or 0) + lastShotData.autoCount
        local sessionId = lastShotData.sessionId or tostring(math.random(100000, 999999))

        local st = spreadState[tool]
        if not st then
            st = { cur = 0, lastT = 0 }
            spreadState[tool] = st
        end
        local deg = S and consumeSpread(st, S, false, serverTime) or 0
        local seed = tool:GetAttribute("GunSpreadSeed")
        local sendDir = dir
        if deg > 0 and seed ~= nil and C.NoSpread then
            sendDir = compensate(dir, seed, seq, deg)
        end

        pcall(function()
            GunFire:FireServer(muzzle, muzzle, sendDir, tool.Name, serverTime, false, sessionId, seq)
        end)
    end

    if C.AutoFireMarker and spawnMarkerFn then
        spawnMarkerFn(part.Position, (part.Name == "Head"), part, nil)
    end

    if C.AutoFireSound then
        local isHead = (part.Name == "Head")
        local snd = SoundService:FindFirstChild(isHead and "HeadshotHitSound_UI" or "BodyHitSound_UI")
        if snd then
            pcall(function() snd:Play() end)
        end
    end
end)

