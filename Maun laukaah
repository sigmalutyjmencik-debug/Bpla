local function hideAllESP(d)
    if not d then return end
    for k, v in pairs(d) do
        if k == "bones" then
            for _, l in ipairs(v) do
                if l then pcall(function() l.Visible = false end) end
            end
        elseif v and type(v) ~= "boolean" and type(v) ~= "number" then
            pcall(function() v.Visible = false end)
        end
    end
end

local function updateESP()
    if not Drawing then return end
    local myRt = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local rainbow = C.ERainbow and Color3.fromHSV((tick() * 0.25) % 1, 1, 1) or C.EC
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local d = getOrMakeESP(p)
        if not d then continue end
        local pCh = p.Character
        local hum = pCh and pCh:FindFirstChildOfClass("Humanoid")
        local root = pCh and pCh:FindFirstChild("HumanoidRootPart")
        local head = pCh and pCh:FindFirstChild("Head")
        local isAlive = hum and root and head and hum.Health > 0
        local dist = myRt and root and (myRt.Position - root.Position).Magnitude or math.huge
        if not C.EE or not isAlive or dist > C.ESPDist then
            hideAllESP(d)
            continue
        end
        local topSP, topOn = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.65, 0))
        local botSP, botOn = Cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
        if not topOn or not botOn or topSP.Z <= 0 or botSP.Z <= 0 then
            hideAllESP(d)
            continue
        end
        local rawH = math.abs(botSP.Y - topSP.Y)
        local rawW = rawH * 0.52
        local rawX = topSP.X - rawW / 2
        local rawY = topSP.Y
        local bX = rawX
        local bY = rawY
        local bW = rawW
        local bH = rawH
        local cx = bX + bW / 2
        local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local rr = math.min(255, math.floor(255 * (1 - frac) * 2))
        local gg = math.min(255, math.floor(255 * frac * 2))
        local hpCol = Color3.fromRGB(rr, gg, 30)
        if C.EB then
            if d.boxShadow then
                d.boxShadow.Position = Vector2.new(bX - 1.5, bY - 1.5)
                d.boxShadow.Size = Vector2.new(bW + 3, bH + 3)
                d.boxShadow.Visible = true
            end
            if d.box then
                d.box.Position = Vector2.new(bX, bY)
                d.box.Size = Vector2.new(bW, bH)
                d.box.Color = rainbow
                d.box.Visible = true
            end
        else
            if d.boxShadow then d.boxShadow.Visible = false end
            if d.box then d.box.Visible = false end
        end
        local barW = 4
        local barX = bX - barW - 3
        if d.hpBg then
            d.hpBg.Position = Vector2.new(barX, bY)
            d.hpBg.Size = Vector2.new(barW, bH)
            d.hpBg.Visible = C.EH
        end
        if d.hpFill then
            local fillH = bH * frac
            d.hpFill.Position = Vector2.new(barX, bY + bH - fillH)
            d.hpFill.Size = Vector2.new(barW, fillH)
            d.hpFill.Color = hpCol
            d.hpFill.Visible = C.EH
        end
        local yOff = 0
        if C.EN then
            if d.nameGlow then
                d.nameGlow.Text = p.Name
                d.nameGlow.Size = C.ENS + 1
                d.nameGlow.Color = rainbow
                d.nameGlow.Position = Vector2.new(cx, bY - C.ENS - 5)
                d.nameGlow.Visible = true
            end
            if d.name then
                d.name.Text = p.Name
                d.name.Size = C.ENS
                d.name.Color = Color3.fromRGB(255, 255, 255)
                d.name.Position = Vector2.new(cx, bY - C.ENS - 5)
                d.name.Visible = true
            end
            yOff = yOff + C.ENS + 2
        else
            if d.name then d.name.Visible = false end
            if d.nameGlow then d.nameGlow.Visible = false end
        end
        if C.EH then
            if d.hp then
                d.hp.Text = tostring(math.ceil(hum.Health)) .. " HP"
                d.hp.Color = hpCol
                d.hp.Size = 11
                d.hp.Position = Vector2.new(cx, bY - 12 - yOff - 2)
                d.hp.Visible = true
            end
        else
            if d.hp then d.hp.Visible = false end
        end
        if C.ED then
            if d.dist then
                d.dist.Text = "[" .. math.floor(dist) .. "m]"
                d.dist.Size = 11
                d.dist.Position = Vector2.new(cx, bY + bH + 4)
                d.dist.Visible = true
            end
        else
            if d.dist then d.dist.Visible = false end
        end
        if C.EW then
            local wep = pCh and pCh:FindFirstChildOfClass("Tool")
            if d.wep then
                d.wep.Text = wep and wep.Name or ""
                d.wep.Position = Vector2.new(cx, bY + bH + 16)
                d.wep.Visible = (wep ~= nil)
            end
        else
            if d.wep then d.wep.Visible = false end
        end
        if C.ESkeleton then
            for i, bone in ipairs(BONES) do
                local l = d.bones[i]
                if l then
                    local a = pCh:FindFirstChild(bone[1])
                    local b = pCh:FindFirstChild(bone[2])
                    if a and b then
                        local asp = Cam:WorldToViewportPoint(a.Position)
                        local bsp = Cam:WorldToViewportPoint(b.Position)
                        if asp.Z > 0 and bsp.Z > 0 then
                            l.From = Vector2.new(asp.X, asp.Y)
                            l.To = Vector2.new(bsp.X, bsp.Y)
                            l.Color = rainbow
                            l.Visible = true
                        else
                            l.Visible = false
                        end
                    else
                        l.Visible = false
                    end
                end
            end
        else
            for _, l in ipairs(d.bones) do
                if l then pcall(function() l.Visible = false end) end
            end
        end
    end
end

