local BorderRegistry = {}
local AccentRegistry = {}
local UIUpdaters = {}

local function RegisterBorder(obj, prop)
	table.insert(BorderRegistry, {
		object = obj,
		property = prop or "Color"
	})
end

local function RegisterAccent(obj, prop)
	table.insert(AccentRegistry, {
		object = obj,
		property = prop or "BackgroundColor3"
	})
end

local function registerUpdater(fn)
	table.insert(UIUpdaters, fn)
end

local function refreshUI()
	for _, fn in ipairs(UIUpdaters) do
		pcall(fn)
	end
end

local function SetBorderColor(color)
	C.UIBorderColor = color

	for i = #BorderRegistry, 1, -1 do
		local item = BorderRegistry[i]
		if item.object and item.object.Parent then
			pcall(function()
				item.object[item.property] = color
			end)
		else
			table.remove(BorderRegistry, i)
		end
	end
end

local function SetAccentColor(color)
	C.UIAccentColor = color

	for i = #AccentRegistry, 1, -1 do
		local item = AccentRegistry[i]
		if item.object and item.object.Parent then
			pcall(function()
				item.object[item.property] = color
			end)
		else
			table.remove(AccentRegistry, i)
		end
	end

	refreshUI()
end

