local lastShotData = {
    sessionId = nil,
    lastSeq = 0,
    autoCount = 0,
}

local function processShot(...)
    local a = table.pack(...)
    if typeof(a[1]) ~= "Vector3" or typeof(a[2]) ~= "Vector3"
        or typeof(a[3]) ~= "Vector3" or type(a[4]) ~= "string" then
        return nil
    end

    lastShotData.sessionId = a[7]
    lastShotData.lastSeq = tonumber(a[8]) or lastShotData.lastSeq
    lastShotData.autoCount = 0

    local char = LP.Character
    local tool = char and char:FindFirstChild(a[4])
    local S = tool and getSettings(tool)
    local origin, muzzle = a[2], a[1]
    local maxDist = (S and S.MaxDistance) or C.SADist or 600
    local wanted = a[3]

    if C.SA then
        local part = getTarget(origin, maxDist)
        if C.MuzzleOffset and part then
            local savedWC = C.WC
            C.WC = false
            local partNoWC = getTarget(origin, maxDist)
            C.WC = savedWC
            local targetPart = partNoWC or part
            if targetPart then
                local newMuzzle = getBestMuzzle(targetPart.Position)
                muzzle = newMuzzle
                origin = newMuzzle
                a[1] = newMuzzle
                a[2] = newMuzzle
                local savedWC2 = C.WC
                C.WC = false
                part = getTarget(origin, maxDist)
                C.WC = savedWC2
                if not part then part = targetPart end
            end
        end
        if part then
            wanted = solveAim(origin, part, S)
        end
    end

    local sendDir, realDir = wanted, wanted
    if S and tool then
        local st = spreadState[tool]
        if not st then
            st = { cur = 0, lastT = 0 }
            spreadState[tool] = st
        end
        local deg = consumeSpread(st, S, a[6] == true, a[5])
        local seed = tool:GetAttribute("GunSpreadSeed")
        if deg > 0 and seed ~= nil then
            if C.NoSpread then
                sendDir = compensate(wanted, seed, a[8], deg)
                realDir = wanted
            else
                realDir = applySpread(wanted, seed, a[8], deg)
            end
        end
    end

    registerPendingShot(muzzle, realDir, maxDist)

    if sendDir == a[3] then return nil end
    a[3] = sendDir
    return a
end

