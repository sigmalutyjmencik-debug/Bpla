local memoryConfigs = {}

local function sanitizeName(name)
	name = tostring(name or ""):gsub("%s+", "")
	name = name:gsub("[^%w_%-%.]", "")
	return name
end

local function folderPath(name)
	return CONFIG_FOLDER .. "/" .. name .. ".json"
end

local function rootPath(name)
	return "AstraConfig_" .. name .. ".json"
end

local function readIndex()
	if not canRead then
		return {}
	end

	local ok, data = pcall(readfile, INDEX_FILE)
	if not ok then
		return {}
	end

	local decoded = jsonDecode(data)
	if type(decoded) == "table" then
		return decoded
	end

	return {}
end

local function writeIndex(list)
	if not canWrite then
		return
	end

	pcall(writefile, INDEX_FILE, jsonEncode(list))
end

local function addToIndex(name)
	local idx = readIndex()
	local found = false

	for _, v in ipairs(idx) do
		if v == name then
			found = true
			break
		end
	end

	if not found then
		table.insert(idx, name)
		writeIndex(idx)
	end
end

local function removeFromIndex(name)
	local idx = readIndex()
	for i, v in ipairs(idx) do
		if v == name then
			table.remove(idx, i)
			break
		end
	end
	writeIndex(idx)
end

local function listConfigNames()
	local set = {}

	for name in pairs(memoryConfigs) do
		set[name] = true
	end

	for _, name in ipairs(readIndex()) do
		if type(name) == "string" then
			set[name] = true
		end
	end

	if canList then
		local ok, files = pcall(listfiles, CONFIG_FOLDER)
		if ok and type(files) == "table" then
			for _, f in ipairs(files) do
				local name = f:match("([^/\\]+)%.json$")
				if name then
					set[name] = true
				end
			end
		end
	end

	local arr = {}
	for name in pairs(set) do
		table.insert(arr, name)
	end

	table.sort(arr)
	return arr
end

local function serializeC()
	local data = {}

	for k, v in pairs(C) do
		if isColor(v) then
			data[k] = { __color = true, r = v.R, g = v.G, b = v.B }
		elseif k == "Whitelist" then
			local list = {}
			for id, name in pairs(v) do
				table.insert(list, { id = id, name = name })
			end
			data[k] = list
		elseif type(v) ~= "table" then
			data[k] = v
		end
	end

	return jsonEncode(data)
end

local function deserializeC(json)
	local data = jsonDecode(json)

	if not data or type(data) ~= "table" then
		return false
	end

	for k, v in pairs(data) do
		if k == "Whitelist" and type(v) == "table" then
			C.Whitelist = {}
			for _, entry in ipairs(v) do
				if entry.id then
					C.Whitelist[entry.id] = entry.name or tostring(entry.id)
				end
			end
		elseif type(v) == "table" and v.__color then
			C[k] = Color3.new(v.r, v.g, v.b)
		else
			C[k] = v
		end
	end

	return true
end

