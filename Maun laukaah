local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function visible(origin, part, model)
    if not C.WC then return true end
    rayParams.FilterDescendantsInstances = { LP.Character, Cam }
    local r = Workspace:Raycast(origin, part.Position - origin, rayParams)
    return r == nil or r.Instance:IsDescendantOf(model)
end

local function candidateParts(char)
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local root = char:FindFirstChild("HumanoidRootPart")
    local tp = C.TargetPart
    local list = {}
    local function add(p)
        if p then list[#list + 1] = p end
    end
    if tp == "Head" then
        add(head or root)
    elseif tp == "Torso" then
        add(torso or root)
    elseif tp == "HumanoidRootPart" then
        add(root)
    else
        add(head)
        add(torso)
        add(root)
    end
    return list
end

local friendCache = {}
