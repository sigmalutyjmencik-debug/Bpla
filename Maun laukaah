    if d.nameGlow then
        d.nameGlow.Center = true
        d.nameGlow.Visible = false
        d.nameGlow.Font = 2
        d.nameGlow.Size = 14
        d.nameGlow.Transparency = 0.55
    end
    if d.dist then
        d.dist.Center = true
        d.dist.Outline = true
        d.dist.OutlineColor = Color3.fromRGB(0, 0, 0)
        d.dist.Visible = false
        d.dist.Font = 2
        d.dist.Size = 11
        d.dist.Color = Color3.fromRGB(180, 170, 255)
    end
    if d.hp then
        d.hp.Center = true
        d.hp.Outline = true
        d.hp.OutlineColor = Color3.fromRGB(0, 0, 0)
        d.hp.Visible = false
        d.hp.Font = 2
        d.hp.Size = 11
    end
    if d.wep then
        d.wep.Center = true
        d.wep.Outline = true
        d.wep.OutlineColor = Color3.fromRGB(0, 0, 0)
        d.wep.Visible = false
        d.wep.Font = 2
        d.wep.Size = 11
        d.wep.Color = Color3.fromRGB(255, 220, 120)
    end
