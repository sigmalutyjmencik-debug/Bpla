	local uid = tonumber(raw)
	if uid then
		C.Whitelist[uid] = raw
		wlBox.Text = ""
		refreshWl()
		return
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == raw:lower() or p.DisplayName:lower() == raw:lower() then
			C.Whitelist[p.UserId] = p.Name
			wlBox.Text = ""
			refreshWl()
			return
		end
	end

	local ok, id = pcall(function()
		return Players:GetUserIdFromNameAsync(raw)
	end)

	if ok and id then
		C.Whitelist[id] = raw
		wlBox.Text = ""
		refreshWl()
	end
end)

