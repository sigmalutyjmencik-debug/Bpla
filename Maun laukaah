local function makeESP(p)
	if espData[p.UserId] then
		return espData[p.UserId]
	end

	local d = {}
	d.box = dNew("Square")
	d.shadow = dNew("Square")
	d.name = dNew("Text")
	d.hp = dNew("Text")
	d.dist = dNew("Text")
	d.wep = dNew("Text")
	d.hpBg = dNew("Square")
	d.hpFill = dNew("Square")
	d.bones = {}

	if d.shadow then
		d.shadow.Filled = false
		d.shadow.Thickness = 3
		d.shadow.Color = Color3.new(0, 0, 0)
		d.shadow.Visible = false
	end

	if d.box then
		d.box.Filled = false
		d.box.Thickness = 1.5
		d.box.Visible = false
	end

	for _, key in ipairs({ "name", "hp", "dist", "wep" }) do
		local t = d[key]
		if t then
			t.Center = true
			t.Outline = true
			t.OutlineColor = Color3.new(0, 0, 0)
			t.Font = Enum.Font.Code
			t.Visible = false
		end
	end

	if d.name then
		d.name.Size = 13
	end

	if d.hp then
		d.hp.Size = 11
	end

	if d.dist then
		d.dist.Size = 11
	end

	if d.wep then
		d.wep.Size = 11
	end

	if d.hpBg then
		d.hpBg.Filled = true
		d.hpBg.Color = Color3.fromRGB(12, 12, 12)
		d.hpBg.Transparency = 0.25
	end

	if d.hpFill then
		d.hpFill.Filled = true
	end

	for i = 1, #BONES do
		local l = dNew("Line")
		if l then
			l.Thickness = 1
			l.Transparency = 0.2
			l.Visible = false
		end
		d.bones[i] = l
	end

	espData[p.UserId] = d
	return d
end

local function hideESP(d)
	if not d then
		return
	end

	for k, v in pairs(d) do
		if k == "bones" then
			for _, l in ipairs(v) do
				if l then
					l.Visible = false
				end
			end
		elseif v and type(v) ~= "number" and type(v) ~= "boolean" then
			pcall(function()
				v.Visible = false
			end)
		end
	end
end

