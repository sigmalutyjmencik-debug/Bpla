local function updateChams()
    local ch = LP.Character
    if not ch then return end
    local tool = ch:FindFirstChildOfClass("Tool")
    if C.GunChams and tool then
        local target = tool
        local vm = tool:FindFirstChild("ClientADSViewModel")
        if vm and vm:IsA("ObjectValue") and vm.Value and vm.Value.Parent
            and tool:GetAttribute("ADSViewModelActive") == true then
            target = vm.Value
        end
        for _, part in ipairs(target:GetDescendants()) do
            pcall(setPartCham, part, C.GunChamsC, C.GunChamsT)
        end
        if target:IsA("BasePart") then
            pcall(setPartCham, target, C.GunChamsC, C.GunChamsT)
        end
    end
    local armNames = {
        "Left Arm", "Right Arm",
        "LeftHand", "LeftLowerArm", "LeftUpperArm",
        "RightHand", "RightLowerArm", "RightUpperArm"
    }
    if C.HandChams then
        for _, name in ipairs(armNames) do
            local part = ch:FindFirstChild(name)
            if part then
                pcall(setPartCham, part, C.HandChamsC, C.HandChamsT)
                for _, desc in ipairs(part:GetDescendants()) do
                    pcall(setPartCham, desc, C.HandChamsC, C.HandChamsT)
                end
            end
        end
    end
    for _, obj in ipairs(Cam:GetDescendants()) do
        local name = obj.Name:lower():gsub("%s+", " ")
        if name:find("hand") or name:find("arm") then
            if C.HandChams then
                pcall(setPartCham, obj, C.HandChamsC, C.HandChamsT)
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hlName = "PCham" .. p.UserId
            local hl = chamFolder:FindFirstChild(hlName)
            if C.EChams then
