local function drawBeam(a, b, color, width, lifetime)
    local len = (b - a).Magnitude
    if len < 0.5 then return end
    local folder = Instance.new("Folder")
    folder.Parent = Cam
    local pA = Instance.new("Part")
    pA.Anchored = true
    pA.CanCollide = false
    pA.CanQuery = false
    pA.CanTouch = false
    pA.CastShadow = false
    pA.Transparency = 1
    pA.Size = Vector3.new(0.01, 0.01, 0.01)
    pA.CFrame = CFrame.new(a)
    pA.Parent = folder
    local pB = pA:Clone()
    pB.CFrame = CFrame.new(b)
    pB.Parent = folder
    local att0 = Instance.new("Attachment", pA)
    local att1 = Instance.new("Attachment", pB)
    local beam = Instance.new("Beam")
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.1),
        NumberSequenceKeypoint.new(1, 1)
    })
    beam.Width0 = width * 0.05
    beam.Width1 = 0.01
    beam.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.15, color),
        ColorSequenceKeypoint.new(1, color)
    })
    beam.CurveSize0 = 0
    beam.CurveSize1 = 0
    beam.Segments = 12
    beam.Parent = folder
    local glow = beam:Clone()
    glow.Width0 = width * 0.22
    glow.Width1 = 0.01
    glow.Color = ColorSequence.new(color)
    glow.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4),
        NumberSequenceKeypoint.new(0.4, 0.7),
        NumberSequenceKeypoint.new(1, 1)
    })
    glow.Parent = folder
    TweenService:Create(beam, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Width0 = 0, Width1 = 0
    }):Play()
    TweenService:Create(glow, TweenInfo.new(lifetime * 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Width0 = 0, Width1 = 0
    }):Play()
    Debris:AddItem(folder, lifetime + 0.15)
end

local function confirmHitAndDrawLine(hitPos)
    if not C.BL then return end
    local now = tick()
    for i = #pendingShots, 1, -1 do
        local shot = pendingShots[i]
        if now - shot.t0 < 2.5 then
            local color = C.BLRainbow and Color3.fromHSV((tick() * 0.5) % 1, 1, 1) or C.BLC
            drawBeam(shot.muzzle, hitPos, color, C.BLW, C.BLT)
            table.remove(pendingShots, i)
            return
        end
    end
end

