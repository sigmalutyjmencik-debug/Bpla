local pendingShots = {}

local function addPendingShot(info)
	if not C.BL or not info then
		return
	end

	info.time = tick()
	info.used = false
	table.insert(pendingShots, info)

	while #pendingShots > 80 do
		table.remove(pendingShots, 1)
	end
end

local function isHostilePart(part)
	if not isBasePart(part) then
		return false
	end

	local model = part:FindFirstAncestorOfClass("Model")

	if model == LP.Character then
		return false
	end

	if model then
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end

		if hasTag(model, "BriskRuntimeSentinel") then
			return true
		end

		if model:FindFirstChild("BodyHitBox") then
			return true
		end
	end

	if hasTag(part, "BriskRuntimeSentinel") then
		return true
	end

	return false
end

local function tryDrawBulletLine(hitPos, hitPart)
	if not C.BL or not isVec3(hitPos) or not isHostilePart(hitPart) then
		return
	end

	local now = tick()

	for i = #pendingShots, 1, -1 do
		local ps = pendingShots[i]

		if not ps.used and now - ps.time <= 1.2 then
			ps.used = true
			local color = C.BLRainbow and Color3.fromHSV((tick() * 0.5) % 1, 1, 1) or C.BLC
			drawBeam(ps.muzzle or ps.origin, hitPos, color, C.BLW, C.BLT)
			return
		end
	end
end

