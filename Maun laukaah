local freecamActive = false
local freecamPos = Vector3.zero
local freecamYaw = 0
local freecamPitch = 0
local touchLookId = nil
local touchLookPos = nil
local joyVector = Vector2.zero

UserInputService.InputChanged:Connect(function(input)
    if C.FreeCam and input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = input.Delta
        freecamYaw = freecamYaw - d.X * C.FreeCamSens
        freecamPitch = math.clamp(freecamPitch - d.Y * C.FreeCamSens, -89, 89)
    end
end)

UserInputService.TouchStarted:Connect(function(t, gp)
    if C.FreeCam and not gp and t.Position.X > Cam.ViewportSize.X * 0.45 then
        touchLookId = t
        touchLookPos = t.Position
    end
end)

UserInputService.TouchMoved:Connect(function(t)
    if C.FreeCam and touchLookId == t and touchLookPos then
        local d = t.Position - touchLookPos
        touchLookPos = t.Position
        freecamYaw = freecamYaw - d.X * C.FreeCamSens
        freecamPitch = math.clamp(freecamPitch - d.Y * C.FreeCamSens, -89, 89)
    end
end)

UserInputService.TouchEnded:Connect(function(t)
    if touchLookId == t then
        touchLookId = nil
        touchLookPos = nil
    end
end)

RunService.RenderStepped:Connect(function(dt)
    forceVisuals()
    updateESP()
    if C.FreeCam then
        if not freecamActive then
            freecamActive = true
            freecamPos = Cam.CFrame.Position
            local rx, ry = Cam.CFrame:ToEulerAnglesYXZ()
            freecamPitch = math.deg(rx)
            freecamYaw = math.deg(ry)
            Cam.CameraType = Enum.CameraType.Scriptable
        end
        local rot = CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)
        local cf = CFrame.new(freecamPos) * rot
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
        if joyVector.Magnitude > 0 then
            move = move + cf.LookVector * -joyVector.Y + cf.RightVector * joyVector.X
        end
        if move.Magnitude > 0 then freecamPos = freecamPos + move.Unit * C.FreeCamSpeed * dt end
        Cam.CFrame = CFrame.new(freecamPos) * rot
    else
        if freecamActive then
            freecamActive = false
            Cam.CameraType = Enum.CameraType.Custom
        end
    end
end)

