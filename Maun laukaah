local function getOrCreate(className, name)
    local e = Lighting:FindFirstChild(name)
    if e and e:IsA(className) then return e end
    e = Instance.new(className)
    e.Name = name
    e.Parent = Lighting
    return e
end

local function purgeOthers(className, keepName)
    for _, c in ipairs(Lighting:GetChildren()) do
        if c:IsA(className) and c.Name ~= keepName then
            c:Destroy()
        end
    end
end

