local PickerTarget = nil
local PickerCallback = nil
local HueValue = 0
local Saturation = 1
local Brightness = 1
local PendingColor = ACCENT_COLOR
local PaletteDragging = false
local HueDragging = false

local function UpdatePicker()
    local hueColor = Color3.fromHSV(HueValue, 1, 1)
    Palette.BackgroundColor3 = hueColor
    PendingColor = Color3.fromHSV(HueValue, Saturation, Brightness)
    PaletteCursor.Position = UDim2.new(Saturation, 0, 1 - Brightness, 0)
    HueCursor.Position = UDim2.new(0.5, 0, HueValue, 0)
    RGBLabel.Text = string.format("RGB: %d, %d, %d",
        math.floor(PendingColor.R * 255 + 0.5),
        math.floor(PendingColor.G * 255 + 0.5),
        math.floor(PendingColor.B * 255 + 0.5))
end

local function LoadColor(color)
    HueValue, Saturation, Brightness = color:ToHSV()
    PendingColor = color
    UpdatePicker()
end

function OpenPicker(configKey, previewObj, callback)
    PickerTarget = configKey
    PickerCallback = callback
    LoadColor(C[configKey] or ACCENT_COLOR)
    local viewport = Workspace.CurrentCamera.ViewportSize
    local px, py = 100, 150
    if previewObj and previewObj.AbsolutePosition then
        px = previewObj.AbsolutePosition.X + 20
        py = previewObj.AbsolutePosition.Y
    end
    if px + 160 > viewport.X then px = viewport.X - 180 end
    if py + 160 > viewport.Y then py = viewport.Y - 170 end
    Picker.Position = UDim2.fromOffset(math.max(5, px), math.max(5, py))
    Picker.Visible = true
end

local function UpdatePalette(input)
    local pos = Palette.AbsolutePosition
    local size = Palette.AbsoluteSize
    Saturation = math.clamp((input.Position.X - pos.X) / size.X, 0, 1)
    Brightness = 1 - math.clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
    UpdatePicker()
end

Palette.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        PaletteDragging = true
        UpdatePalette(input)
    end
end)

local function UpdateHue(input)
    local pos = Hue.AbsolutePosition
    local size = Hue.AbsoluteSize
    HueValue = math.clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
    UpdatePicker()
end

Hue.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        HueDragging = true
        UpdateHue(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if PaletteDragging then UpdatePalette(input) end
    if HueDragging then UpdateHue(input) end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        PaletteDragging = false
        HueDragging = false
    end
end)

ApplyButton.MouseButton1Click:Connect(function()
    if PickerTarget and PickerCallback then
        PickerCallback(PendingColor)
    end
    Picker.Visible = false
end)

