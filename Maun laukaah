		return true
	end

	if myTeamMembers[plr.UserId] then
		return true
	end

	local myClan = LP:GetAttribute("ClanId")
	local theirClan = plr:GetAttribute("ClanId")
	if myClan ~= nil and theirClan ~= nil and tostring(myClan) == tostring(theirClan) then
		return true
	end

	if myTeamId ~= nil and plr:GetAttribute("TeamId") == myTeamId then
		return true
	end

	if LP.Team ~= nil and plr.Team == LP.Team then
		return true
	end

	return false
end

