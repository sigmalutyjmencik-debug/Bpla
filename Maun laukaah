local function updatePlayerESP(p, color, myRoot)
	local d = makeESP(p)
	local ch = p.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	local head = ch and ch:FindFirstChild("Head")
	local alive = hum and root and head and hum.Health > 0
	local dist = myRoot and root and (myRoot.Position - root.Position).Magnitude or math.huge

	if not C.EE or not alive or dist > C.ESPDist then
		hideESP(d)
		return
	end

	local top, onTop = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.65, 0))
	local bottom, onBottom = Cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))

	if not onTop or not onBottom or top.Z <= 0 or bottom.Z <= 0 then
		hideESP(d)
		return
	end

	local h = math.abs(bottom.Y - top.Y)
	local w = h * 0.52
	local x = top.X - w / 2
	local y = top.Y
	local cx = x + w / 2

	if C.EB then
		if d.shadow then
			d.shadow.Position = Vector2.new(x - 1.5, y - 1.5)
			d.shadow.Size = Vector2.new(w + 3, h + 3)
			d.shadow.Visible = true
		end

		if d.box then
			d.box.Position = Vector2.new(x, y)
			d.box.Size = Vector2.new(w, h)
			d.box.Color = color
			d.box.Visible = true
		end
	else
		if d.shadow then
			d.shadow.Visible = false
		end

		if d.box then
			d.box.Visible = false
		end
	end

	local frac = clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
	local hpColor = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(255 * frac), 40)

	if C.EH then
		local bw = 4
		local bx = x - bw - 4

		if d.hpBg then
			d.hpBg.Position = Vector2.new(bx, y)
			d.hpBg.Size = Vector2.new(bw, h)
			d.hpBg.Visible = true
		end

		if d.hpFill then
			d.hpFill.Position = Vector2.new(bx, y + h * (1 - frac))
			d.hpFill.Size = Vector2.new(bw, h * frac)
			d.hpFill.Color = hpColor
			d.hpFill.Visible = true
		end

		if d.hp then
			d.hp.Text = tostring(math.ceil(hum.Health)) .. " HP"
			d.hp.Color = hpColor
			d.hp.Position = Vector2.new(cx, y - 27)
			d.hp.Visible = true
		end
	else
		if d.hpBg then
			d.hpBg.Visible = false
		end

		if d.hpFill then
			d.hpFill.Visible = false
		end

		if d.hp then
			d.hp.Visible = false
		end
	end

	if C.EN and d.name then
		d.name.Text = p.Name
		d.name.Size = C.ENS
		d.name.Color = color
		d.name.Position = Vector2.new(cx, y - C.ENS - 6)
		d.name.Visible = true
	elseif d.name then
		d.name.Visible = false
	end

	if C.ED and d.dist then
		d.dist.Text = "[" .. math.floor(dist) .. "m]"
		d.dist.Color = color
		d.dist.Position = Vector2.new(cx, y + h + 3)
		d.dist.Visible = true
	elseif d.dist then
		d.dist.Visible = false
	end

	if C.EW and d.wep then
		local tool = ch:FindFirstChildOfClass("Tool")
		d.wep.Text = tool and tool.Name or ""
		d.wep.Color = color
		d.wep.Position = Vector2.new(cx, y + h + 16)
		d.wep.Visible = tool ~= nil
	elseif d.wep then
		d.wep.Visible = false
	end

	if C.ESkeleton then
		for i, bone in ipairs(BONES) do
			local l = d.bones[i]
			local a = ch:FindFirstChild(bone[1])
			local b = ch:FindFirstChild(bone[2])

			if l and a and b then
				local asp = Cam:WorldToViewportPoint(a.Position)
				local bsp = Cam:WorldToViewportPoint(b.Position)

				if asp.Z > 0 and bsp.Z > 0 then
					l.From = Vector2.new(asp.X, asp.Y)
					l.To = Vector2.new(bsp.X, bsp.Y)
					l.Color = color
					l.Visible = true
				else
					l.Visible = false
				end
			elseif l then
				l.Visible = false
			end
		end
	else
		for _, l in ipairs(d.bones) do
			if l then
				l.Visible = false
			end
		end
	end
end

