local function SetBorderColor(color)
    BORDER_COLOR = color
    for i = #BorderRegistry, 1, -1 do
        local item = BorderRegistry[i]
        if item.object and item.object.Parent then
            pcall(function() item.object[item.property] = color end)
        else
            table.remove(BorderRegistry, i)
        end
    end
end

