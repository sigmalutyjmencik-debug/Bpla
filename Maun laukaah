local function CreateSlider(parent, name, key, min, max, isFloat, cb)
	if C[key] == nil then
		C[key] = min
	end

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -4, 0, 40)
	row.BackgroundTransparency = 1
	row.ZIndex = 12
	row.Parent = parent

	local valLbl = Text(row, isFloat and string.format("%.2f", C[key]) or tostring(C[key]), UDim2.new(1, -70, 0, 0), UDim2.new(0, 70, 0, 20), 12, WHITE)
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.ZIndex = 12

	local nameLbl = Text(row, name, UDim2.fromOffset(4, 0), UDim2.new(1, -80, 0, 20), 13, WHITE)
	nameLbl.ZIndex = 12

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -8, 0, 12)
	bar.Position = UDim2.fromOffset(4, 24)
	bar.BackgroundColor3 = BARBG
	bar.BorderSizePixel = 0
	bar.ZIndex = 13
	bar.Parent = row

	Stroke(bar, 1)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(clamp((C[key] - min) / (max - min), 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = C.UIAccentColor
	fill.BorderSizePixel = 0
	fill.ZIndex = 14
	fill.Parent = bar

	RegisterAccent(fill, "BackgroundColor3")

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromScale(1, 1)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.ZIndex = 15
	btn.Parent = bar

	local dragging = false

	local function update(input)
		local ratio = clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local val = isFloat and min + (max - min) * ratio or math.floor(min + (max - min) * ratio + 0.5)
		C[key] = val
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		valLbl.Text = isFloat and string.format("%.2f", val) or tostring(val)

		if cb then
			cb(val)
		end
	end

	registerUpdater(function()
		local val = C[key] or min
		local ratio = clamp((val - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		valLbl.Text = isFloat and string.format("%.2f", val) or tostring(val)
	end)

	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
end

