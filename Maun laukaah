local function updateESP()
    if not Drawing then return end
    local myRt = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local rainbow = C.ERainbow and Color3.fromHSV((tick() * 0.25) % 1, 1, 1) or C.EC
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local d = getOrMakeESP(p)
            if d then
                local pCh = p.Character
                local hum = pCh and pCh:FindFirstChildOfClass("Humanoid")
                local root = pCh and pCh:FindFirstChild("HumanoidRootPart")
                local head = pCh and pCh:FindFirstChild("Head")
                local isAlive = hum and root and head and hum.Health > 0
                local dist = myRt and root and (myRt.Position - root.Position).Magnitude or math.huge
                if not C.EE or not isAlive or dist > C.ESPDist then
                    hideAllESP(d)
                else
                    local topSP, topOn = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.65, 0))
                    local botSP, botOn = Cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
                    if not topOn or not botOn or topSP.Z <= 0 or botSP.Z <= 0 then
                        hideAllESP(d)
                    else
                        local bH = math.abs(botSP.Y - topSP.Y)
                        local bW = bH * 0.52
                        local bX = topSP.X - bW / 2
                        local bY = topSP.Y
                        local cx = bX + bW / 2
                        local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        local hpCol = Color3.fromRGB(math.min(255, math.floor(255 * (1 - frac) * 2)), math.min(255, math.floor(255 * frac * 2)), 30)
                        if C.EB then
                            if d.boxShadow then
                                d.boxShadow.Position = Vector2.new(bX - 1.5, bY - 1.5)
                                d.boxShadow.Size = Vector2.new(bW + 3, bH + 3)
                                d.boxShadow.Visible = true
                            end
                            if d.box then
                                d.box.Position = Vector2.new(bX, bY)
                                d.box.Size = Vector2.new(bW, bH)
                                d.box.Color = rainbow
                                d.box.Visible = true
                            end
                        else
                            if d.boxShadow then d.boxShadow.Visible = false end
