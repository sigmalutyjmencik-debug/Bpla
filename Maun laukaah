local function getSettings(tool)
	if not tool then
		return nil
	end

	local S = settingsCache[tool]
	if not S then
		local mod = tool:FindFirstChild("Settings")
		if mod and mod:IsA("ModuleScript") then
			local ok, res = pcall(require, mod)
			if ok and type(res) == "table" then
				S = res
				settingsCache[tool] = S
			end
		end
	end

	if S then
		tweakSettings(S)
	end

	return S
end

local function watchTools()
	local function onTool(t)
		if t:IsA("Tool") then
			task.defer(function()
				task.wait(0.15)
				getSettings(t)
			end)
		end
	end

	local function hookContainer(c)
		if not c then
			return
		end

		for _, t in ipairs(c:GetChildren()) do
			onTool(t)
		end

		c.ChildAdded:Connect(onTool)
	end

	if LP.Character then
		hookContainer(LP.Character)
	end

	LP.CharacterAdded:Connect(hookContainer)

	local bp = LP:FindFirstChildOfClass("Backpack") or LP:WaitForChild("Backpack", 10)
	if bp then
		hookContainer(bp)
	end

	LP.ChildAdded:Connect(function(c)
		if c:IsA("Backpack") then
			hookContainer(c)
		end
	end)
end

