local function getTarget(origin)
	local center = Cam.ViewportSize / 2
	local bestPart, bestD = nil, C.FOV
	local myChar = LP.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	local function consider(part, model)
		if not part then
			return
		end

		local distFromOrigin = (part.Position - origin).Magnitude
		if distFromOrigin > C.SADist then
			return
		end

		if myRoot and (myRoot.Position - part.Position).Magnitude > C.SADist then
			return
		end

		local sp, on = Cam:WorldToViewportPoint(part.Position)
		if not on or sp.Z <= 0 then
			return
		end

		local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
		if d < bestD and visible(origin, part, model) then
			bestD = d
			bestPart = part
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if not shouldSkip(p) and p.Character then
			local ch = p.Character
			local hum = ch:FindFirstChildOfClass("Humanoid")
			local skip = (not hum) or hum.Health <= 0

			if not skip and C.IgnoreFF and ch:FindFirstChildOfClass("ForceField") then
				skip = true
			end

			if not skip then
				for _, part in ipairs(candidateParts(ch)) do
					consider(part, ch)
				end
			end
		end
	end

	if C.TargetDrones then
		for _, d in ipairs(CollectionService:GetTagged("BriskRuntimeSentinel")) do
			if d:IsDescendantOf(Workspace) and d:GetAttribute("SentinelDead") ~= true then
				local part = d:FindFirstChild("BodyHitBox") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
				consider(part, d)
			end
		end
	end

	return bestPart
end

local function solveAim(origin, part, S)
	local pos = part.Position

	if not C.Pr then
		return (pos - origin).Unit
	end

	local model = part:FindFirstAncestorOfClass("Model")
	local root = model and model:FindFirstChild("HumanoidRootPart")
	local vel = (root and root.AssemblyLinearVelocity) or part.AssemblyLinearVelocity
	local speed = S and S.BulletSpeed

	if type(speed) ~= "number" or speed <= 0 then
		return (pos - origin).Unit
	end

	local t = (pos - origin).Magnitude / speed
	local aim = pos

	for _ = 1, 5 do
		aim = pos + vel * t
		t = (aim - origin).Magnitude / speed
	end

	if S and S.BulletDrop == true then
		local g = Workspace.Gravity * ((type(S.BulletGravityMult) == "number") and S.BulletGravityMult or 1)
		local sd = S.BulletDropStartDistance

		if type(sd) ~= "number" then
			local fr = S.BulletDropStartFraction
			fr = (type(fr) == "number") and fr or 0

			if fr > 1 then
				fr = fr / 100
			end

			sd = (S.MaxDistance or C.SADist or 600) * clamp(fr, 0, 1)
		end

		local startT = sd / math.max(speed, 1)
		local td = math.max(0, t - startT)
		aim = aim + Vector3.new(0, 0.5 * g * td * td, 0)
	end

	return (aim - origin).Unit
end

local muzzleRay = RaycastParams.new()
muzzleRay.FilterType = Enum.RaycastFilterType.Exclude
muzzleRay.IgnoreWater = true

local function getBestMuzzle(targetPos)
	local ch = LP.Character
	if not ch then
		return Cam.CFrame.Position
	end

	local root = ch:FindFirstChild("HumanoidRootPart")
	if not root then
		return Cam.CFrame.Position
	end

	local cf = root.CFrame
	local offsets = {
		cf * Vector3.new(0, 4, 0),
		cf * Vector3.new(4, 1.5, 0),
		cf * Vector3.new(-4, 1.5, 0),
		cf * Vector3.new(0, 2, -3),
		cf * Vector3.new(0, 6, 0),
		Cam.CFrame.Position
	}

	muzzleRay.FilterDescendantsInstances = buildFilter()

	local best = nil
	local bestScore = math.huge

	for _, candidate in ipairs(offsets) do
		local toTarget = targetPos - candidate
		local dist = toTarget.Magnitude
		local r = Workspace:Raycast(candidate, toTarget, muzzleRay)

		if not r then
			if dist < bestScore then
				bestScore = dist
				best = candidate
			end
		end
	end

	return best or Cam.CFrame.Position
end

local function drawBeam(a, b, color, width, lifetime)
	local len = (b - a).Magnitude
	if len < 0.5 then
		return
	end

	local folder = Instance.new("Folder")
	folder.Parent = Cam

	local pA = Instance.new("Part")
	pA.Anchored = true
	pA.CanCollide = false
	pA.CanQuery = false
	pA.CanTouch = false
	pA.CastShadow = false
	pA.Transparency = 1
	pA.Size = Vector3.new(0.05, 0.05, 0.05)
	pA.CFrame = CFrame.new(a)
	pA.Parent = folder

	local pB = pA:Clone()
	pB.CFrame = CFrame.new(b)
	pB.Parent = folder

	local att0 = Instance.new("Attachment", pA)
	local att1 = Instance.new("Attachment", pB)

	local beam = Instance.new("Beam")
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Width0 = width * 0.05
	beam.Width1 = 0.01
	beam.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.15, color),
		ColorSequenceKeypoint.new(1, color)
	})
