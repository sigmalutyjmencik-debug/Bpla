                hl.Adornee = p.Character
                hl.FillColor = C.EChamsC
                hl.FillTransparency = C.EChamsT
                hl.OutlineTransparency = 1
                hl.Enabled = true
            elseif hl then
                hl.Enabled = false
                hl.Adornee = nil
            end
        end
    end
end

