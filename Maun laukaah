local function tweakSettings(S)
	pcall(function()
		if table.isfrozen and table.isfrozen(S) and type(setreadonly) == "function" then
			setreadonly(S, false)
		end

		if not originalSettings[S] then
			originalSettings[S] = copySettings(S)
		end

		local orig = originalSettings[S]

		if C.NoRecoil then
			S.RecoilStrength = 0
			S.RecoilImpulseMultiplier = 0
			S.RecoilYawMult = 0
			S.RecoilPitchMult = 0
			S.RecoilKick = 0
			S.CameraRecoil = 0
		else
			if orig.RecoilStrength ~= nil then S.RecoilStrength = orig.RecoilStrength end
			if orig.RecoilImpulseMultiplier ~= nil then S.RecoilImpulseMultiplier = orig.RecoilImpulseMultiplier end
			if orig.RecoilYawMult ~= nil then S.RecoilYawMult = orig.RecoilYawMult end
			if orig.RecoilPitchMult ~= nil then S.RecoilPitchMult = orig.RecoilPitchMult end
			if orig.RecoilKick ~= nil then S.RecoilKick = orig.RecoilKick end
			if orig.CameraRecoil ~= nil then S.CameraRecoil = orig.CameraRecoil end
		end

		if C.MuteShot or C.MuteWeaponSounds then
			S.GunshotVolume = 0
			S.ReloadVolume = 0
			S.FireVolume = 0
			S.ShotVolume = 0
			S.SoundVolume = 0
		else
			if orig.GunshotVolume ~= nil then S.GunshotVolume = orig.GunshotVolume end
			if orig.ReloadVolume ~= nil then S.ReloadVolume = orig.ReloadVolume end
			if orig.FireVolume ~= nil then S.FireVolume = orig.FireVolume end
			if orig.ShotVolume ~= nil then S.ShotVolume = orig.ShotVolume end
			if orig.SoundVolume ~= nil then S.SoundVolume = orig.SoundVolume end
		end

		if C.RapidFire then
			S.FireRate = 0.01
			S.FireDelay = 0.01
			S.Cooldown = 0.01
			S.ShootCooldown = 0.01
			if orig.ReloadTime then S.ReloadTime = math.min(orig.ReloadTime, 0.15) end
			if orig.ReloadDuration then S.ReloadDuration = math.min(orig.ReloadDuration, 0.15) end
			S.RPM = 9999
			S.FireRPM = 9999
			S.Delay = 0.01
		else
			if orig.FireRate ~= nil then S.FireRate = orig.FireRate end
			if orig.FireDelay ~= nil then S.FireDelay = orig.FireDelay end
			if orig.Cooldown ~= nil then S.Cooldown = orig.Cooldown end
			if orig.ShootCooldown ~= nil then S.ShootCooldown = orig.ShootCooldown end
			if orig.ReloadTime ~= nil then S.ReloadTime = orig.ReloadTime end
			if orig.ReloadDuration ~= nil then S.ReloadDuration = orig.ReloadDuration end
			if orig.RPM ~= nil then S.RPM = orig.RPM end
			if orig.FireRPM ~= nil then S.FireRPM = orig.FireRPM end
