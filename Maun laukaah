                            d.dist.Size = 11
                            d.dist.Color = rainbow
                            d.dist.Position = Vector2.new(cx, bY + bH + 4)
                            d.dist.Visible = true
                        elseif d.dist then
                            d.dist.Visible = false
                        end
                        if C.EW and d.wep then
                            local wep = pCh:FindFirstChildOfClass("Tool")
                            d.wep.Text = wep and wep.Name or ""
                            d.wep.Size = 11
                            d.wep.Color = rainbow
                            d.wep.Position = Vector2.new(cx, bY + bH + 17)
                            d.wep.Visible = wep ~= nil
                        elseif d.wep then
                            d.wep.Visible = false
                        end
                        if C.ESkeleton then
                            for i, bone in ipairs(BONES) do
                                local l = d.bones[i]
                                if l then
                                    local a = pCh:FindFirstChild(bone[1])
                                    local b = pCh:FindFirstChild(bone[2])
                                    if a and b then
                                        local asp = Cam:WorldToViewportPoint(a.Position)
                                        local bsp = Cam:WorldToViewportPoint(b.Position)
                                        if asp.Z > 0 and bsp.Z > 0 then
                                            l.From = Vector2.new(asp.X, asp.Y)
                                            l.To = Vector2.new(bsp.X, bsp.Y)
                                            l.Color = rainbow
                                            l.Visible = true
                                        else
                                            l.Visible = false
                                        end
                                    else
                                        l.Visible = false
                                    end
                                end
                            end
                        else
                            for _, l in ipairs(d.bones) do
                                if l then pcall(function() l.Visible = false end) end
                            end
                        end
                    end
                end
            end
        end
    end
end

local TELEPORT_UP = 2
local ACCEL = 0.4
local DECEL = 0.4
local TOTAL = 2.5
local RESTART_BLOCK = 2.4
local ANTIDETECT_TIME = 1.5
local ANTIDETECT_SPEED = 1
local isSliding = false
local slideConn, bodyVel, bodyPos, slideThread
local startY, blockUntil, slideStartT = 0, 0, 0

local function getCharEl()
    local ch = LP.Character
    if not ch then return nil, nil end
    return ch:FindFirstChild("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
end

local function stopSlide()
    isSliding = false
    blockUntil = tick() + RESTART_BLOCK
    if slideThread then pcall(task.cancel, slideThread) slideThread = nil end
    if slideConn then slideConn:Disconnect() slideConn = nil end
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if bodyPos then bodyPos:Destroy() bodyPos = nil end
    local h = getCharEl()
    if h then
        h:ChangeState(Enum.HumanoidStateType.Freefall)
        h.WalkSpeed = 16
    end
end

local function startSlide()
    if not C.SlideOn or tick() < blockUntil or isSliding then return end
    local h, rt = getCharEl()
    if not h or not rt then return end
    isSliding = true
    slideStartT = tick()
    startY = rt.Position.Y
    if C.SlideTP then
        rt.CFrame = rt.CFrame * CFrame.new(0, TELEPORT_UP, 0)
        startY = rt.Position.Y
    end
    bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(0, math.huge, 0)
    bodyPos.Position = rt.Position
    bodyPos.Parent = rt
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(math.huge, 0, math.huge)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = rt
    local maxS = C.SlideSpeed
    slideConn = RunService.Heartbeat:Connect(function()
        local h2, rt2 = getCharEl()
        if not (h2 and rt2 and bodyVel and bodyPos) then stopSlide() return end
        local elapsed = tick() - slideStartT
        local yP = math.clamp(elapsed / ACCEL, 0, 1)
        local targetY = startY + (C.SlideTP and TELEPORT_UP or 0) * yP
        if C.AntiDetect and elapsed > ANTIDETECT_TIME then
            targetY = targetY - (elapsed - ANTIDETECT_TIME) * ANTIDETECT_SPEED
        end
        bodyPos.Position = Vector3.new(rt2.Position.X, targetY, rt2.Position.Z)
        local spd = 0
        if elapsed < ACCEL then
            spd = maxS * (elapsed / ACCEL)
        elseif elapsed < TOTAL - DECEL then
            spd = maxS
        else
            spd = maxS * (1 - (elapsed - (TOTAL - DECEL)) / DECEL)
        end
        local md = h2.MoveDirection
        bodyVel.Velocity = (md.Magnitude > 0 and md or rt2.CFrame.LookVector) * spd
        h2.WalkSpeed = 16
        if elapsed >= TOTAL then stopSlide() end
    end)
    slideThread = task.delay(TOTAL, stopSlide)
end

