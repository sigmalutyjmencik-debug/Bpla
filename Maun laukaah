local colorCallback = nil
local HueValue, Saturation, Brightness = 0, 1, 1
local PendingColor = C.UIAccentColor
local PaletteDragging = false
local HueDragging = false

local function UpdatePicker()
	Palette.BackgroundColor3 = Color3.fromHSV(HueValue, 1, 1)
	PendingColor = Color3.fromHSV(HueValue, Saturation, Brightness)
	PaletteCursor.Position = UDim2.new(Saturation, 0, 1 - Brightness, 0)
	HueCursor.Position = UDim2.new(0.5, 0, HueValue, 0)
	RGBLabel.Text = string.format("RGB: %d, %d, %d", math.floor(PendingColor.R * 255 + 0.5), math.floor(PendingColor.G * 255 + 0.5), math.floor(PendingColor.B * 255 + 0.5))
end

local function LoadColor(color)
	HueValue, Saturation, Brightness = color:ToHSV()
	PendingColor = color
	UpdatePicker()
end

local function OpenPicker(color, cb)
	colorCallback = cb
	LoadColor(color or C.UIAccentColor)
	local viewport = Cam.ViewportSize
	Picker.Position = UDim2.fromOffset(viewport.X / 2 - 80, viewport.Y / 2 - 90)
	Picker.Visible = true
end

Palette.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		PaletteDragging = true
		local pos = Palette.AbsolutePosition
		local size = Palette.AbsoluteSize
		Saturation = clamp((input.Position.X - pos.X) / size.X, 0, 1)
		Brightness = 1 - clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
		UpdatePicker()
	end
end)

Hue.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		HueDragging = true
		HueValue = clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
		UpdatePicker()
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if PaletteDragging then
		local pos = Palette.AbsolutePosition
		local size = Palette.AbsoluteSize
		Saturation = clamp((input.Position.X - pos.X) / size.X, 0, 1)
		Brightness = 1 - clamp((input.Position.Y - pos.Y) / size.Y, 0, 1)
		UpdatePicker()
	end

	if HueDragging then
		HueValue = clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
		UpdatePicker()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		PaletteDragging = false
		HueDragging = false
	end
end)

