local wlRows = {}
local function refreshWlList()
    for _, r in ipairs(wlRows) do r:Destroy() end
    wlRows = {}
    for id, name in pairs(C.Whitelist) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 26)
        row.BackgroundColor3 = DROPBG
        row.BorderSizePixel = 0
        row.Parent = wlListFrame
        Stroke(row, 1)
        Text(row, tostring(name) .. " (" .. tostring(id) .. ")", UDim2.fromOffset(8, 0), UDim2.new(1, -40, 1, 0), 11, WHITE)
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.fromOffset(24, 20)
        delBtn.Position = UDim2.new(1, -28, 0.5, -10)
        delBtn.BackgroundColor3 = Color3.fromRGB(130, 40, 40)
        delBtn.BorderSizePixel = 0
        delBtn.Text = "✕"
        delBtn.TextColor3 = WHITE
        delBtn.Font = Enum.Font.Code
        delBtn.TextSize = 11
        delBtn.AutoButtonColor = false
        delBtn.Parent = row
        Corner(delBtn, 3)
        delBtn.MouseButton1Click:Connect(function()
            C.Whitelist[id] = nil
            refreshWlList()
        end)
        wlRows[#wlRows + 1] = row
    end
end

wlAddBtn.MouseButton1Click:Connect(function()
    local raw = wlBox.Text:gsub("%s+", "")
    if raw == "" then return end
    local uid = tonumber(raw)
    if uid then
        C.Whitelist[uid] = raw
        wlBox.Text = ""
        refreshWlList()
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == raw:lower() or p.DisplayName:lower() == raw:lower() then
            C.Whitelist[p.UserId] = p.Name
            wlBox.Text = ""
            refreshWlList()
            return
        end
    end
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(raw)
    end)
    if ok and id then
        C.Whitelist[id] = raw
        wlBox.Text = ""
        refreshWlList()
    end
end)
refreshWlList()

