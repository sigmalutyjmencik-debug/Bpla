local function mkSlider(parent, name, key, min, max, def, isFloat, cb)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -4, 0, 42)
    holder.BackgroundTransparency = 1
    holder.Parent = parent
    Text(holder, name, UDim2.fromOffset(2, 2), UDim2.new(1, -80, 0, 18), 12, WHITE)
    local valLbl = Text(holder, isFloat and string.format("%.2f", def) or tostring(def), UDim2.new(1, -60, 0, 2), UDim2.fromOffset(58, 18), 11, GRAY)
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(2, 22)
    bar.Size = UDim2.new(1, -4, 0, 14)
    bar.BackgroundColor3 = BARBG
    bar.BorderSizePixel = 0
    bar.Parent = holder
    Stroke(bar, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(math.clamp((def - min) / (max - min), 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = ACCENT_COLOR
    fill.BorderSizePixel = 0
    fill.Parent = bar
    RegisterAccent(fill, "BackgroundColor3")
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 5
    btn.Parent = bar
    local dragging = false
    local function update(input)
        local x = input.Position.X - bar.AbsolutePosition.X
        local ratio = math.clamp(x / bar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        local val = isFloat and (min + (max - min) * ratio) or math.floor(min + (max - min) * ratio + 0.5)
        C[key] = val
        valLbl.Text = isFloat and string.format("%.2f", val) or tostring(val)
        if cb then cb(val) end
    end
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

