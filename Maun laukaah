local TELEPORT_UP = 2
local ACCEL = 0.4
local DECEL = 0.4
local TOTAL = 2.5
local RESTART_BLOCK = 2.4
local SLIDE_ANTIDETECT_TIME = 1.5
local SLIDE_ANTIDETECT_SPEED = 1
local isSliding = false
local slideConn, bodyVel, bodyPos, slideThread
local startY, blockUntil, slideStartT = 0, 0, 0

local function getCharEl()
	local ch = LP.Character
	if not ch then
		return nil, nil
	end
	return ch:FindFirstChild("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
end

local function stopSlide()
	isSliding = false
	blockUntil = tick() + RESTART_BLOCK

	if slideThread then
		pcall(task.cancel, slideThread)
		slideThread = nil
	end

	if slideConn then
		slideConn:Disconnect()
		slideConn = nil
	end

	if bodyVel then
		bodyVel:Destroy()
		bodyVel = nil
	end

	if bodyPos then
		bodyPos:Destroy()
		bodyPos = nil
	end

	local h = getCharEl()
	if h then
		h:ChangeState(Enum.HumanoidStateType.Freefall)
		h.WalkSpeed = 16
	end
end

local function startSlide()
	if not C.SlideOn or tick() < blockUntil or isSliding then
		return
	end

	local h, rt = getCharEl()
	if not h or not rt then
		return
	end

	isSliding = true
	slideStartT = tick()
	startY = rt.Position.Y

	if C.SlideTP then
		rt.CFrame = rt.CFrame * CFrame.new(0, TELEPORT_UP, 0)
		startY = rt.Position.Y
	end

	bodyPos = Instance.new("BodyPosition")
	bodyPos.MaxForce = Vector3.new(0, math.huge, 0)
	bodyPos.Position = rt.Position
	bodyPos.Parent = rt

	bodyVel = Instance.new("BodyVelocity")
	bodyVel.MaxForce = Vector3.new(math.huge, 0, math.huge)
	bodyVel.Velocity = Vector3.new(0, 0, 0)
	bodyVel.Parent = rt

	local maxS = C.SlideSpeed

	slideConn = RunService.Heartbeat:Connect(function()
		local h2, rt2 = getCharEl()

		if not (h2 and rt2 and bodyVel and bodyPos) then
			stopSlide()
			return
		end

		local elapsed = tick() - slideStartT
		local yP = clamp(elapsed / ACCEL, 0, 1)
		local targetY = startY + (C.SlideTP and TELEPORT_UP or 0) * yP

		if C.AntiDetect and elapsed > SLIDE_ANTIDETECT_TIME then
			local descendAmount = (elapsed - SLIDE_ANTIDETECT_TIME) * SLIDE_ANTIDETECT_SPEED
			targetY = targetY - descendAmount
		end

		bodyPos.Position = Vector3.new(rt2.Position.X, targetY, rt2.Position.Z)

		local spd = 0
		if elapsed < ACCEL then
			spd = maxS * (elapsed / ACCEL)
		elseif elapsed < TOTAL - DECEL then
			spd = maxS
		else
			spd = maxS * (1 - (elapsed - (TOTAL - DECEL)) / DECEL)
		end

		local md = h2.MoveDirection
		bodyVel.Velocity = (md.Magnitude > 0 and md or rt2.CFrame.LookVector) * spd
		h2.WalkSpeed = 16

		if elapsed >= TOTAL then
			stopSlide()
		end
	end)

	slideThread = task.delay(TOTAL, stopSlide)
end

local function handler(self, ...)
	if not oldNamecall then
		return
	end

	local method = hasGetNamecallMethod and getnamecallmethod() or nil

	if method == "FireServer" and not chkc() then
		if not firingInternally then
			local a = table.pack(...)

			if isGunArgs(a) or (GunFire and rawequal(self, GunFire)) then
				lastShotRemote = self
				local processed = table.pack(pcall(processShot, ...))

				if hasSetNamecallMethod then
					pcall(setnamecallmethod, "FireServer")
				end

				if processed[1] then
					local res = processed[2]
					local info = processed[3]

					if res then
						local call = table.pack(pcall(oldNamecall, self, unpackTbl(res, 1, res.n)))
						if call[1] then
							if info then
								addPendingShot(info)
							end
							return unpackTbl(call, 2, call.n)
						end
					end
				end
			end
		end

		if MovEv and rawequal(self, MovEv) then
			local a = { ... }
			if a[1] == "Sliding" then
				if a[2] == true and C.SlideOn then
					startSlide()
				elseif a[2] == false then
					blockUntil = 0
					if isSliding then
						stopSlide()
						blockUntil = 0
					end
				end
			end
		end
	end

	return oldNamecall(self, ...)
end

if hasHookMetamethod then
	local ok, hooked = pcall(hookmetamethod, game, "__namecall", newc(handler))
	if ok and hooked then
		oldNamecall = hooked
	end
elseif hasGetRawMetatable then
	local okMt, mt = pcall(getrawmetatable, game)
	if okMt and mt and mt.__namecall then
		oldNamecall = mt.__namecall
		safeRO(mt, false)
		mt.__namecall = newc(handler)
		safeRO(mt, true)
	end
end

local function fireShotAt(part)
	local remote = lastShotRemote or findGunFire()
	if not remote or not part then
		return false
	end

	local ch = LP.Character
	if not ch then
		return false
	end

	local tool = ch:FindFirstChild(lastShotToolName or "") or ch:FindFirstChildOfClass("Tool")
	if not tool then
		return false
	end

	local S = getSettings(tool)
	local origin = Cam.CFrame.Position
	local muzzle = C.MuzzleOffset and getBestMuzzle(part.Position) or origin
	local dir = solveAim(muzzle, part, S)
	local now = serverTime()

	local seq = (toolSeqs[tool] or 0) + 1
	toolSeqs[tool] = seq

	local session = toolSessions[tool]
	if not session then
		session = tool:GetAttribute("GunSessionId") or tool:GetAttribute("SessionId") or tostring(math.random(100000, 999999))
		toolSessions[tool] = session
	end

	local args

	if lastShotArgs and isGunArgs(lastShotArgs) then
		args = cloneTable(lastShotArgs)
		args[1] = muzzle
		args[2] = muzzle
		args[3] = dir
		args[4] = tool.Name
		args[5] = now
		args[6] = false
		args[7] = session
		args[8] = seq
		args.n = math.max(args.n or 8, 8)
	else
		args = table.pack(muzzle, muzzle, dir, tool.Name, now, false, session, seq)
	end

	if S then
		local st = spreadState[tool]
		if not st then
			st = { cur = 0, lastT = 0 }
			spreadState[tool] = st
		end

		local deg = consumeSpread(st, S, false, now)
		local seed = tool:GetAttribute("GunSpreadSeed")

		if deg > 0 and seed ~= nil and C.NoSpread then
			args[3] = compensate(dir, seed, args[8], deg)
		end
	end

	local info = {
		muzzle = muzzle,
		origin = origin,
		dir = args[3],
		maxDist = (S and S.MaxDistance) or C.SADist,
		tool = tool.Name
	}

	firingInternally = true
	local ok = pcall(function()
		remote:FireServer(unpackTbl(args, 1, args.n or #args))
	end)
	firingInternally = false

	if ok then
		addPendingShot(info)
	end

	return ok
end

