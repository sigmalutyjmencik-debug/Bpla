local function isGunArgs(a)
	return isVec3(a[1]) and isVec3(a[2]) and isVec3(a[3]) and type(a[4]) == "string"
end

local function processShot(...)
	local a = table.pack(...)

	if not isGunArgs(a) then
		return nil
	end

	lastShotArgs = cloneTable(a)
	lastShotToolName = a[4]

	local char = LP.Character
	local tool = char and char:FindFirstChild(a[4])
	local S = tool and getSettings(tool)
	local origin = a[2]
	local muzzle = a[1]
	local wanted = a[3]
	local maxDist = (S and S.MaxDistance) or C.SADist or 600

	if C.SA then
		local part = getTarget(origin)

		if C.MuzzleOffset and part then
			local newMuzzle = getBestMuzzle(part.Position)
			muzzle = newMuzzle
			origin = newMuzzle
			a[1] = newMuzzle
			a[2] = newMuzzle
			part = getTarget(origin) or part
		end

		if part then
			wanted = solveAim(origin, part, S)
		end
	end

	local sendDir = wanted
	local realDir = wanted

	if S and tool then
		local st = spreadState[tool]
		if not st then
			st = { cur = 0, lastT = 0 }
			spreadState[tool] = st
		end

		local deg = consumeSpread(st, S, a[6] == true, a[5] or serverTime())
		local seed = tool:GetAttribute("GunSpreadSeed")

		if deg > 0 and seed ~= nil then
			if C.NoSpread then
				sendDir = compensate(wanted, seed, a[8], deg)
				realDir = wanted
			else
				realDir = applySpread(wanted, seed, a[8], deg)
			end
		end
	end

	local info = {
		muzzle = muzzle,
		origin = origin,
		dir = realDir,
		maxDist = maxDist,
		tool = a[4]
	}

	if sendDir ~= a[3] then
		a[3] = sendDir
	end

	return a, info
end

