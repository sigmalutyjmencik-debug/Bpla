RunService.RenderStepped:Connect(function(dt)
	pcall(updateESP)
	pcall(enforceVisuals)

	local baseFOV = C.DefaultFOV

	if C.ADSFOVChanger then
		local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
		local ads = tool and tool:GetAttribute("ADSViewModelActive") == true
		if ads or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			baseFOV = C.ADSFOV
		end
	end

	targetFOV = targetFOV + (baseFOV - targetFOV) * 0.15

	if C.FreeCam then
		if not freecamActive then
			freecamActive = true
			freecamPos = Cam.CFrame.Position
			local rx, ry = Cam.CFrame:ToEulerAnglesYXZ()
			freecamPitch = math.deg(rx)
			freecamYaw = math.deg(ry)
			Cam.CameraType = Enum.CameraType.Scriptable
		end

		local rot = CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)
		local cf = CFrame.new(freecamPos) * rot
		local move = Vector3.new(0, 0, 0)

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move = move + cf.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move = move - cf.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move = move + cf.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move = move - cf.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			move = move + Vector3.new(0, 1, 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			move = move - Vector3.new(0, 1, 0)
		end

		if joyVector.Magnitude > 0 then
			move = move + cf.LookVector * -joyVector.Y + cf.RightVector * joyVector.X
		end

		local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0 then
			local md = hum.MoveDirection
			move = move + cf.LookVector * md:Dot(Cam.CFrame.LookVector) + cf.RightVector * md:Dot(Cam.CFrame.RightVector)
		end

		if move.Magnitude > 0 then
			freecamPos = freecamPos + move.Unit * C.FreeCamSpeed * dt
		end

		Cam.CFrame = CFrame.new(freecamPos) * rot
		pcall(function()
			Cam.FieldOfView = targetFOV
		end)
	else
		if freecamActive then
			freecamActive = false
			Cam.CameraType = Enum.CameraType.Custom
		end

		pcall(function()
			Cam.FieldOfView = targetFOV
		end)
	end

	if C.VMChanger then
		local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
		local vm = tool and tool:FindFirstChild("ClientADSViewModel")

		if vm and vm:IsA("ObjectValue") and vm.Value then
			local offset = CFrame.new(C.VMX, C.VMY, C.VMZ) * CFrame.Angles(math.rad(C.VMRX), math.rad(C.VMRY), math.rad(C.VMRZ))
			pcall(function()
				vm.Value:PivotTo(Cam.CFrame * offset)
			end)
		end
	end

	if snapLine then
		if C.SA and C.SnapLine then
			local target = getTarget(Cam.CFrame.Position)

			if target then
				local sp, on = Cam:WorldToViewportPoint(target.Position)

				if on and sp.Z > 0 then
					snapLine.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
					snapLine.To = Vector2.new(sp.X, sp.Y)
					snapLine.Color = C.SnapLineColor
					snapLine.Thickness = C.SnapLineThickness
					snapLine.Visible = true
				else
					snapLine.Visible = false
				end
			else
				snapLine.Visible = false
			end
		else
			snapLine.Visible = false
		end
	end
end)

