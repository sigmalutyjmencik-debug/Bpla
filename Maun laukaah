local function getCfgPath(name)
    return "astra_cfg_" .. tostring(name):gsub("[^%w_%-]", "_") .. ".json"
end

local function serializeC()
    local t = {}
    for k, v in pairs(C) do
        if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
            t[k] = v
        elseif typeof(v) == "Color3" then
            t[k] = {__c = true, r = v.R, g = v.G, b = v.B}
        end
    end
    return HttpService:JSONEncode(t)
end

local function deserializeC(json)
    local ok, t = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(t) ~= "table" then return false end
    for k, v in pairs(t) do
        if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then
            C[k] = v
        elseif type(v) == "table" and v.__c then
            C[k] = Color3.new(v.r, v.g, v.b)
        end
    end
    return true
end

